# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# PostgreSQL connection (Supabase-compatible)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Generate a long, random secret locally; never commit it.
JWT_SECRET=

# Optional Resend email delivery. Configure only in the server environment.
RESEND_API_KEY=
EMAIL_FROM=SendTheLetter <letters@example.com>
